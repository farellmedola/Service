# Mansa API — secret côté serveur uniquement
MANSA_API_KEY=
# true uniquement en Preview d'évaluation avec attribution; Production reste désactivé
MANSA_PUBLIC_DISPLAY_AUTHORIZED=false
# L'historique OHLCV quotidien exige Mansa Pro ou supérieur
MANSA_HISTORY_ENABLED=false
# Neon PostgreSQL — utiliser le rôle lecture seule pour les endpoints de lecture
DATABASE_READONLY_URL=
